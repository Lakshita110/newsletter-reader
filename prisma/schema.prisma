generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RssRankSnapshotStatus {
  AI_SUCCESS
  FALLBACK_DETERMINISTIC
}

enum RssRankSnapshotSource {
  CRON
  ON_DEMAND
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  rssRecommendationCap     Int                       @default(35)
  rssRecommendationPrompt  String?                   @db.VarChar(500)
  digestEnabled            Boolean                   @default(false)
  digestEmail              String?
  digestTimezone           String                    @default("UTC")
  weeklyReadingGoal        Int                       @default(5)
  digestLastSentAt         DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  messageReadStats         MessageReadStat[]
  rssSubscriptions         UserRssSubscription[]
  rssRankSnapshots         UserRssDailyRankSnapshot[]
  rssReadProfileSnapshot   UserRssReadProfileSnapshot?
  newsletterSenders        NewsletterSender[]
  newsletterIssues         NewsletterIssue[]
  newslettersSyncedAt      DateTime?
  saveToken                String?                   @unique
  /// Google refresh token for Gmail sync, AES-GCM encrypted (lib/token-crypto.ts).
  /// Kept server-side so the app login and Gmail access are independent.
  gmailRefreshTokenEnc     String?
  /// Why Gmail access last failed (e.g. invalid_grant); null when connected.
  gmailTokenError          String?
  /// True when the Gmail mailbox was chosen with "Use a different Gmail"
  /// rather than being the sign-in account; sign-in then leaves it alone.
  gmailConnectedSeparately Boolean                   @default(false)
  savedArticles            SavedArticle[]
  highlights               Highlight[]
  itemSummaries            ItemSummary[]
}

model MessageReadStat {
  id                 String   @id @default(cuid())
  userId             String
  messageExternalId  String
  messageTitle       String?
  sourceKind         String?
  publicationName    String?
  firstOpenedAt      DateTime?
  lastOpenedAt       DateTime?
  openCount          Int      @default(0)
  totalSecondsRead   Int      @default(0)
  maxScrollPct       Float    @default(0)
  completionPct      Float    @default(0)
  completedAt        DateTime?
  savedAt            DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, messageExternalId])
  @@index([userId, lastOpenedAt])
  @@index([userId, savedAt])
  @@index([messageExternalId])
}

model RssSource {
  id                   String                @id @default(cuid())
  name                 String
  rssUrl               String                @unique
  normalizedUrl        String                @unique
  siteUrl              String?
  isActive             Boolean               @default(true)
  lastSyncedAt         DateTime?
  consecutiveFailures  Int                   @default(0)
  lastErrorAt          DateTime?
  lastErrorMessage     String?               @db.VarChar(500)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  items                RssItem[]
  subscriptions        UserRssSubscription[]

  @@index([normalizedUrl])
}

model UserRssSubscription {
  id          String      @id @default(cuid())
  userId      String
  rssSourceId String
  isActive    Boolean     @default(true)
  category    String      @default("other")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      RssSource   @relation(fields: [rssSourceId], references: [id], onDelete: Cascade)

  @@unique([userId, rssSourceId])
  @@index([userId, isActive])
}

model RssItem {
  id           String    @id @default(cuid())
  rssSourceId  String
  externalId   String
  title        String
  author       String?
  link         String?
  imageUrl     String?
  publishedAt  DateTime?
  snippet      String?
  htmlRaw      String?   @db.Text
  textExtracted String?  @db.Text
  /// Full-text search vector, a Postgres GENERATED column (see the baseline
  /// migration). Declared only so schema/migration drift checks agree with
  /// the database; read it with $queryRaw (app/api/search/route.ts).
  searchVector Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, ((((COALESCE(title, ''::text) || ' '::text) || COALESCE(snippet, ''::text)) || ' '::text) || COALESCE(\"textExtracted\", ''::text)))"))
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  source       RssSource @relation(fields: [rssSourceId], references: [id], onDelete: Cascade)

  @@unique([rssSourceId, externalId])
  @@index([rssSourceId, publishedAt])
  @@index([searchVector], type: Gin)
}

model UserRssDailyRankSnapshot {
  id               String                @id @default(cuid())
  userId           String
  dayKey           String
  rankedItemIds    Json
  rankReasons      Json                  @default("{}")
  status           RssRankSnapshotStatus
  source           RssRankSnapshotSource
  model            String?
  inputFingerprint String
  expiresAt        DateTime
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
  @@index([dayKey, expiresAt])
}

model UserRssReadProfileSnapshot {
  id                String   @id @default(cuid())
  userId            String   @unique
  weekKey           String
  topPublications   Json
  avgCompletionPct  Float
  recentReadCount7d Int
  preferenceSummary Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([weekKey, updatedAt])
}

/// A sender the user explicitly reads. When a user has any active senders,
/// newsletter sync matches exactly these addresses across all mail (inbox,
/// archived, labeled) instead of guessing with the classifier over the inbox.
model NewsletterSender {
  id        String   @id @default(cuid())
  userId    String
  email     String
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId, isActive])
}

/// A newsletter email copied out of Gmail so it stays readable after it ages
/// out of the Gmail lookback window, and so the inbox doesn't need a Gmail
/// round-trip per message on every load.
model NewsletterIssue {
  id             String   @id @default(cuid())
  userId         String
  gmailMessageId String
  threadId       String?
  fromEmail      String
  fromName       String
  publicationKey String
  subject        String
  snippet        String?
  receivedAt     DateTime
  html           String?  @db.Text
  text           String?  @db.Text
  webUrl         String?
  /// Lead photo picked from the email (lib/lead-image.ts); "" when the
  /// issue was checked and has none, null when not checked yet.
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gmailMessageId])
  @@index([userId, receivedAt])
}

/// A web page saved from anywhere (share sheet, bookmarklet, paste). When the
/// client sends the page HTML (e.g. from a logged-in browser on a paywalled
/// site) we keep that; otherwise the server fetches the URL itself.
model SavedArticle {
  id          String   @id @default(cuid())
  userId      String
  url         String
  title       String
  siteName    String?
  author      String?
  excerpt     String?
  imageUrl    String?
  html        String?  @db.Text
  text        String?  @db.Text
  wordCount   Int      @default(0)
  savedVia    String   @default("app")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, url])
  @@index([userId, createdAt])
}

/// A passage highlighted in the reader, optionally with a note. Anchored by
/// the quoted text plus a little surrounding context (not DOM offsets), so it
/// survives re-rendering, view switches, and re-extraction of the article.
model Highlight {
  id              String   @id @default(cuid())
  userId          String
  itemId          String
  itemTitle       String
  publicationName String?
  itemUrl         String?
  quote           String   @db.Text
  prefix          String?
  suffix          String?
  note            String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, itemId])
  @@index([userId, createdAt])
}

/// Cached on-demand summary of one item, so tapping "Summarize" twice (or on
/// another device) never pays for a second model call.
model ItemSummary {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  summary   String   @db.Text
  model     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}
